# TubeAgent Configuration

# Local Folder Paths on your Laptop
# You can specify any Windows folder path, e.g.:
# LOCAL_WATCH_FOLDER=C:/Users/blago/Videos/YouTube_Inbox
# LOCAL_PROCESSED_FOLDER=C:/Users/blago/Videos/YouTube_Processed
LOCAL_WATCH_FOLDER=./watch_folder
LOCAL_PROCESSED_FOLDER=./processed_folder
LOCAL_DATA_FOLDER=./data
LOCAL_CAT_VIDEOS_FOLDER=./cat_videos

# Container Internal Paths (Used by Docker or native script)
WATCH_FOLDER=./watch_folder
PROCESSED_FOLDER=./processed_folder
FAILED_FOLDER=./failed_folder
CAT_VIDEOS_FOLDER=./cat_videos
DATA_DIR=./data

# YouTube API Credentials
CLIENT_SECRETS_FILE=./data/client_secrets.json
TOKEN_FILE=./data/token.json

# Default Video Privacy: "private", "unlisted", or "public"
DEFAULT_PRIVACY=private

# YouTube Category ID: 28 = Science & Technology, 27 = Education, 24 = Entertainment, etc.
DEFAULT_CATEGORY_ID=28

# Google Gemini AI API Key (Get at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Workflow Mode
# true: Instantly upload to YouTube after AI analysis
# false: Pause for user review & approval in the Web Dashboard
AUTO_UPLOAD=false

# Folder Watcher Stability Check (seconds)
STABILITY_CHECK_SECONDS=3
SCAN_INTERVAL_SECONDS=5

# Web Server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ==========================================
# Cat Explainer Agent (Be100 Gmail Agent)
# ==========================================
# Folder where generated 10-second cat videos will be saved
CAT_VIDEOS_FOLDER=./cat_videos

# Gmail OAuth Token file (separate from YouTube token)
GMAIL_TOKEN_FILE=./data/gmail_token.json

# Subject prefix to match incoming production request emails
GMAIL_SUBJECT_PREFIX=Be100 Prod:

# How frequently to poll Gmail inbox for new tasks (in seconds)
GMAIL_POLL_INTERVAL_SECONDS=30

# Automatically mark processed emails as read
GMAIL_AUTO_MARK_READ=true

# Google Veo Video Generation Model
VEO_MODEL=veo-2.0-generate-001
VEO_ASPECT_RATIO=9:16
VEO_DURATION_SECONDS=10
